{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard",
  "labels": ["renovatebot"],
  "baseBranchPatterns": ["dev"],
  "flux": {
    "managerFilePatterns": ["/flux/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions in .tf files annotated with a # renovate: comment",
      "managerFilePatterns": ["/\\.tf$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+\\w+\\s*=\\s*\"[^\"\\n]*?(?<currentValue>\\d+\\.\\d+\\.\\d+)[^\"\\n]*\""
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "OpenTofu version in terraform required_version",
      "managerFilePatterns": ["/\\.tf$/"],
      "matchStrings": ["required_version\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "opentofu",
      "packageNameTemplate": "opentofu/opentofu",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "hashicorp",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "required_version is handled by the OpenTofu custom manager, not the built-in one (which tracks hashicorp/terraform)",
      "matchManagers": ["terraform"],
      "matchDepTypes": ["required_version"],
      "enabled": false
    },
    {
      "description": "Bump the OpenTofu required_version range",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["opentofu"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Look up providers and modules in the OpenTofu registry",
      "matchDatasources": ["terraform-provider", "terraform-module"],
      "registryUrls": ["https://registry.opentofu.org"]
    }
  ]
}
