{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard",
  "labels": ["renovatebot"],
  "baseBranchPatterns": ["dev"],
  "flux": {
    "managerFilePatterns": ["/flux/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions in .tf files annotated with a # renovate: comment",
      "managerFilePatterns": ["/\\.tf$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+\\w+\\s*=\\s*\"[^\"\\n]*?(?<currentValue>\\d+\\.\\d+\\.\\d+)[^\"\\n]*\""
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Track OpenTofu (not Terraform) for required_version and bump the range",
      "matchManagers": ["terraform"],
      "matchDepTypes": ["required_version"],
      "overridePackageName": "opentofu/opentofu",
      "commitMessageTopic": "OpenTofu",
      "rangeStrategy": "bump"
    },
    {
      "description": "Look up providers and modules in the OpenTofu registry",
      "matchDatasources": ["terraform-provider", "terraform-module"],
      "registryUrls": ["https://registry.opentofu.org"]
    }
  ]
}
